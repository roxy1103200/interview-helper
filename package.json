{
  "name": "interview-helper",
  "version": "0.1.1",
  "private": true,
  "description": "Windows interview workspace with dual audio transcription",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron .",
    "pack": "tsc --noEmit && electron-vite build && electron-builder --win --x64 --dir",
    "dist": "tsc --noEmit && electron-vite build && electron-builder --win nsis --x64",
    "format": "prettier --write src tests scripts *.json *.ts *.yml",
    "format:check": "prettier --check src tests scripts *.json *.ts *.yml"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
